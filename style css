* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f6f8;
    color: #222;
}

button {
    border: none;
    cursor: pointer;
    font-family: inherit;
}

.topbar {
    height: 65px;
    background: white;
    border-bottom: 1px solid #ddd;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 30px;
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    font-size: 22px;
    font-weight: bold;
}

.logout-btn {
    background: #222;
    color: white;
    padding: 10px 18px;
    border-radius: 8px;
}

.screen {
    min-height: calc(100vh - 65px);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30px;
}

.welcome-card {
    background: white;
    width: 600px;
    max-width: 100%;
    padding: 45px;
    border-radius: 18px;
    text-align: center;
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
}

.welcome-card h1 {
    font-size: 32px;
    margin-bottom: 10px;
}

.welcome-card p {
    color: #777;
    margin-bottom: 30px;
}

.role-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.role-btn {
    background: #fff;
    border: 2px solid #eee;
    padding: 30px 15px;
    border-radius: 14px;
    font-size: 36px;
    transition: 0.2s;
}

.role-btn:hover {
    border-color: #ff5a1f;
    transform: translateY(-3px);
}

.role-btn strong {
    display: block;
    font-size: 18px;
    margin-top: 15px;
}

.role-btn span {
    display: block;
    font-size: 13px;
    color: #777;
    margin-top: 7px;
}

.dashboard-section {
    max-width: 1200px;
    margin: auto;
    padding: 30px;
}

.dashboard-header {
    background: white;
    padding: 25px;
    border-radius: 15px;
    margin-bottom: 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
}

.dashboard-header h1 {
    font-size: 28px;
    margin-bottom: 5px;
}

.dashboard-header p {
    color: #777;
}

.secondary-btn {
    padding: 12px 18px;
    border-radius: 8px;
    background: #eee;
}

.primary-btn {
    background: #ff5a1f;
    color: white;
    padding: 12px 20px;
    border-radius: 8px;
    font-weight: bold;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin-bottom: 25px;
}

.stat-card {
    background: white;
    padding: 22px;
    border-radius: 14px;
    box-shadow: 0 3px 12px rgba(0,0,0,0.04);
}

.stat-card span {
    font-size: 25px;
}

.stat-card h3 {
    font-size: 25px;
    margin: 10px 0 5px;
}

.stat-card p {
    color: #777;
    font-size: 14px;
}

.tabs {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
    background: white;
    padding: 8px;
    border-radius: 10px;
}

.tab {
    background: transparent;
    padding: 12px 20px;
    border-radius: 8px;
    font-weight: bold;
}

.tab.active {
    background: #ff5a1f;
    color: white;
}

.tab-content h2 {
    margin-bottom: 18px;
}

.order-card,
.delivery-card {
    background: white;
    padding: 22px;
    border-radius: 15px;
    margin-bottom: 18px;
    box-shadow: 0 3px 12px rgba(0,0,0,0.05);
}

.order-top,
.delivery-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 18px;
}

.order-top h3,
.delivery-top h3 {
    margin-bottom: 5px;
}

.order-top p,
.delivery-top p {
    color: #777;
    font-size: 13px;
}

.status {
    padding: 6px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: bold;
}

.status.new {
    background: #fff0e8;
    color: #ff5a1f;
}

.status.preparing {
    background: #fff8db;
    color: #a67c00;
}

.status.ready {
    background: #e5f7ea;
    color: #198754;
}

.status.active {
    background: #e8f0ff;
    color: #2563eb;
}

.customer-info {
    background: #f7f7f7;
    padding: 15px;
    border-radius: 10px;
    margin-bottom: 15px;
}

.customer-info p {
    color: #777;
    margin-top: 5px;
    font-size: 14px;
}

.items > div {
    display: flex;
    justify-content: space-between;
    padding: 9px 0;
}

.items .total {
    border-top: 1px solid #ddd;
    margin-top: 5px;
    padding-top: 14px;
    font-size: 17px;
}

.order-actions {
    display: flex;
    gap: 10px;
    margin-top: 18px;
}

.accept-btn {
    background: #198754;
    color: white;
    padding: 11px 18px;
    border-radius: 8px;
    font-weight: bold;
}

.reject-btn {
    background: #dc3545;
    color: white;
    padding: 11px 18px;
    border-radius: 8px;
    font-weight: bold;
}

.ready-btn {
    background: #2563eb;
    color: white;
    padding: 11px 18px;
    border-radius: 8px;
    font-weight: bold;
}

.rider-box {
    background: #eaf4ff;
    padding: 14px;
    border-radius: 9px;
    margin-top: 15px;
}

.section-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.menu-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.food-card {
    background: white;
    padding: 20px;
    border-radius: 15px;
}

.food-image {
    height: 130px;
    background: #f3f3f3;
    border-radius: 10px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 55px;
    margin-bottom: 15px;
}

.food-card p {
    color: #777;
    margin: 6px 0;
    font-size: 14px;
}

.food-card strong {
    display: block;
    font-size: 19px;
    margin-bottom: 14px;
}

.small-btn,
.small-danger {
    padding: 8px 13px;
    border-radius: 7px;
    margin-right: 5px;
}

.small-btn {
    background: #eee;
}

.small-danger {
    background: #ffe5e5;
    color: #dc3545;
}

.sales-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 20px;
}

.sales-summary > div {
    background: white;
    padding: 25px;
    border-radius: 14px;
}

.sales-summary p {
    color: #777;
    margin-bottom: 8px;
}

.sales-summary h2 {
    font-size: 28px;
}

.sales-table {
    background: white;
    border-radius: 14px;
    overflow: hidden;
}

.table-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    padding: 17px 20px;
    border-bottom: 1px solid #eee;
}

.table-head {
    background: #f7f7f7;
    font-weight: bold;
}

.online-status {
    background: #e7f8ed;
    color: #198754;
    padding: 10px 15px;
    border-radius: 20px;
    font-weight: bold;
}

.online-status span {
    display: inline-block;
    width: 9px;
    height: 9px;
    background: #198754;
    border-radius: 50%;
    margin-right: 5px;
}

.route {
    margin: 20px 0;
}

.route-point {
    display: flex;
    align-items: center;
    gap: 14px;
}

.route-point > span {
    width: 40px;
    height: 40px;
    background: #f2f2f2;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
}

.route-point p {
    color: #777;
    font-size: 13px;
    margin-top: 4px;
}

.route-line {
    width: 2px;
    height: 25px;
    background: #ddd;
    margin: 3px 0 3px 19px;
}

.delivery-price {
    font-size: 20px;
    color: #198754;
}

.distance {
    background: #f7f7f7;
    padding: 12px;
    border-radius: 8px;
    margin-bottom: 15px;
    color: #555;
}

.full-btn {
    width: 100%;
}

.delivery-progress {
    display: flex;
    justify-content: space-between;
    margin: 25px 0;
    position: relative;
}

.progress-step {
    text-align: center;
    width: 33%;
    color: #777;
}

.progress-step span {
    display: inline-flex;
    width: 35px;
    height: 35px;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    background: #eee;
    margin-bottom: 7px;
}

.progress-step.completed {
    color: #198754;
}

.progress-step.completed span {
    background: #dff5e7;
    color: #198754;
}

.active-buttons {
    display: flex;
    gap: 10px;
}

.history-card {
    background: white;
    padding: 18px;
    border-radius: 12px;
    margin-bottom: 12px;
    display: flex;
    justify-content: space-between;
}

.history-card p {
    color: #777;
    margin-top: 5px;
    font-size: 13px;
}

.completed-text {
    display: block;
    color: #198754;
    font-size: 12px;
    margin-top: 5px;
}

@media (max-width: 800px) {

    .role-buttons {
        grid-template-columns: 1fr;
    }

    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .menu-grid {
        grid-template-columns: 1fr 1fr;
    }

    .sales-summary {
        grid-template-columns: 1fr;
    }

    .dashboard-header {
        flex-direction: column;
        align-items: flex-start;
    }
}

@media (max-width: 550px) {

    .topbar {
        padding: 0 15px;
    }

    .dashboard-section {
        padding: 15px;
    }

    .stats-grid {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .stat-card {
        padding: 15px;
    }

    .tabs {
        overflow-x: auto;
    }

    .menu-grid {
        grid-template-columns: 1fr;
    }

    .order-actions,
    .active-buttons {
        flex-direction: column;
    }
}